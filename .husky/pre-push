#!/bin/sh
# ============================================================================
# pre-push — 分単位 / push 差分スコープ / 「壊れたものを push させない」
#   Delegates to `node scripts/gates/verify.mjs` (pnpm verify) which houses
#   the uncommitted change guard logic and all quality/test/smoke gates.
# ============================================================================
set -eu

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"
PATH="$ROOT/node_modules/.bin:$PATH"
export PATH

# --- Uncommitted change guard ---
if git rev-parse --verify HEAD >/dev/null 2>&1; then
  DIRTY=$(git diff --name-only HEAD)
  if [ -n "$DIRTY" ]; then
    echo ""
    echo "❌ 未コミットの変更があります。push を中止しました。"
    echo "$DIRTY" | sed 's/^/   - /'
    echo ""
    exit 1
  fi

  ORPHAN=$(git ls-files --others --exclude-standard -- src tests)
  if [ -n "$ORPHAN" ]; then
    echo ""
    echo "❌ src/ tests/ に未追跡ファイルがあります。HEAD に含まれないため CI/本番ビルドが壊れます。"
    echo "$ORPHAN" | sed 's/^/   - /'
    echo ""
    exit 1
  fi
fi

node scripts/gates/verify.mjs

exit 0
