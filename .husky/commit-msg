#!/bin/sh
# ============================================================================
# commit-msg — Conventional Commits の最小検証（依存なし・約 5ms）
# ============================================================================
set -eu

SUBJECT=$(sed -n '1p' "$1")

case "$SUBJECT" in
  "Merge "*|"Revert "*|fixup!*|squash!*|"") exit 0 ;;
esac

PATTERN='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .+'

if ! printf '%s' "$SUBJECT" | grep -qE "$PATTERN"; then
  printf '\n[commit-msg] Conventional Commits 形式ではありません。\n'
  printf '  受け取った件名: %s\n\n' "$SUBJECT"
  printf '  形式: <type>(<scope>)!: <subject>\n'
  exit 1
fi

# POSIX sh の ${#VAR} はバイト長を返すため、日本語件名では 1 文字 = 3 バイトと
# 数えられ常時誤報する（24 文字程度で 72 バイトに到達）。文字数で数える。
SUBJECT_LEN=$(printf '%s' "$SUBJECT" | LC_ALL=C.UTF-8 wc -m | tr -d ' ')

if [ "$SUBJECT_LEN" -gt 72 ]; then
  printf '\n[warn] 件名が %s 文字です。72 文字以内が読みやすいです。\n\n' "$SUBJECT_LEN"
fi

exit 0
