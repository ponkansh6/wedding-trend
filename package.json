{
  "name": "wedding-trend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "preinstall": "node scripts/gates/only-pnpm.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --nextjs-plugin --react-plugin --react-perf-plugin src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:fast": "oxlint --nextjs-plugin --react-plugin --react-perf-plugin",
    "format:fast": "oxfmt --write .",
    "type-check": "next typegen && tsc --noEmit",
    "check-env": "tsx scripts/gates/check-env.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "prepare": "husky",
    "format:check": "oxfmt --check .",
    "security-check": "bash scripts/gates/check-security.sh",
    "check:deps": "depcheck",
    "check:sources": "node scripts/gates/check-sources.mjs",
    "check:oembed": "node scripts/gates/check-oembed-contract.mjs",
    "verify": "node scripts/gates/verify.mjs",
    "smoke:contract": "bash scripts/gates/smoke-test.sh",
    "smoke:http": "bash scripts/gates/smoke-test-http.sh",
    "eval:llm": "node scripts/archive/eval-llm-compliance.mjs",
    "backfill:usefulness": "tsx scripts/ops/backfill-usefulness.mjs",
    "retract": "tsx scripts/ops/retract.mjs",
    "snapshot:anchors": "tsx scripts/ops/snapshot-anchors.mjs",
    "restore:anchors": "tsx scripts/ops/restore-anchors.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@libsql/client": "^0.17.4",
    "@notionhq/client": "^5.28.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "linkedom": "^0.18.14",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "p-limit": "^7.3.3",
    "radix-ui": "^1.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "robots-parser": "^3.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-pattern": "13.0.4",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "depcheck": "^1.4.7",
    "drizzle-kit": "^0.31.11",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.89.0",
    "secretlint": "^13.0.7",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": "24.22.1"
  },
  "packageManager": "pnpm@11.9.0"
}
