# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# Claude Code のローカル設定（権限許可リスト。個人の信頼判断のため共有しない）
.claude/settings.local.json
# セッション実行サマリー（成果物ではなく作業ログ）
.claude/summaries/

# typescript
*.tsbuildinfo
next-env.d.ts

# ローカル開発用 SQLite（file: スキーム）
local.db
local.db-*
