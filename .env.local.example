# Turso Database (https://turso.tech)
TURSO_DATABASE_URL=libsql://your-database-username.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# Google Gemini API (https://aistudio.google.com/app/apikey)
# AI タイトル・要約・カテゴリ・トレンド/定番タグの生成に使用（gemini-3.1-flash-lite）。
GOOGLE_API_KEY=your-google-api-key

# /api/ingest, /api/submit-url の Bearer 認証トークン。
# fail-closed: 未設定の場合、/api/ingest と /api/submit-url は常に 401 を返す。
# ローカル開発でも例外はないため、必ず以下のように設定すること
# （未設定だと開発サーバー上でも curl で /api/ingest を叩けない）。
# 本番: Vercel Cron（vercel.json の crons）は GET /api/ingest を叩く際、
# この値が Vercel プロジェクトの環境変数として設定されていれば
# `Authorization: Bearer <CRON_SECRET>` ヘッダーを自動付与する。
CRON_SECRET=dev-local-secret

# /admin/* の Basic 認証。収集トリガー（triggerIngest）と SNS URL 投入
# （submitSnsUrl）はオーナー限定の /admin 配下にのみ置かれている。
#
# 2 段で使われる:
# 1. src/middleware.ts が matcher "/admin/:path*" でページ全体を保護する。
#    未設定の場合、本番環境では 503、開発環境では無認証で通す（NODE_ENV で
#    分岐する。ここはページの入口なので、ローカル開発の利便性を優先している）。
# 2. src/lib/auth.ts の isBasicAuthorized() が triggerIngest() / submitSnsUrl()
#    の内部でも同じ資格情報を再検証する（多層防御。UI・ミドルウェアを経由せず
#    Server Action を直接呼ばれても防げるようにするため）。こちらは
#    isBearerAuthorized（CRON_SECRET）と同じ fail-closed 方針を取り、
#    NODE_ENV による分岐を一切行わない。**そのため、未設定のままではローカル
#    開発でも収集ボタン・SNS URL 投入フォームの実行は常に失敗する**（ミドル
#    ウェアが素通ししてページは開けても、Server Action 側で拒否される）。
#    ローカルで動作確認したい場合は必ず以下を設定すること。
ADMIN_BASIC_AUTH_USER=admin
ADMIN_BASIC_AUTH_PASSWORD=your-secure-password

# Instagram oEmbed の access_token（任意）。
# 2026年6月時点、公開投稿へは未設定でも oEmbed 取得可能（1000 req/hr）。
# 将来 Meta 側の仕様変更でトークン必須化された場合に備えて設定できるようにしてある。
# INSTAGRAM_OEMBED_TOKEN=your-instagram-oembed-token

# 公開サイトの絶対 URL（OGP 等に使用。任意）。
# NEXT_PUBLIC_SITE_URL=https://your-domain.example.com
