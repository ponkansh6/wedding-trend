# Turso Database (https://turso.tech)
TURSO_DATABASE_URL=libsql://your-database-username.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# Google Gemini API (https://aistudio.google.com/app/apikey)
# AI タイトル・要約・カテゴリ・トレンド/定番タグの生成に使用（gemini-3.1-flash-lite）。
GOOGLE_API_KEY=your-google-api-key

# /api/ingest, /api/submit-url の Bearer 認証トークン。
# 未設定の場合は無認証で許可される（ローカル開発向け）。本番では必ず設定すること。
# CRON_SECRET=your-cron-secret

# /admin/* の Basic 認証。
# 未設定の場合、本番環境では 503、開発環境では無認証で通す。
# ADMIN_BASIC_AUTH_USER=admin
# ADMIN_BASIC_AUTH_PASSWORD=your-secure-password

# Instagram oEmbed の access_token（任意）。
# 2026年6月時点、公開投稿へは未設定でも oEmbed 取得可能（1000 req/hr）。
# 将来 Meta 側の仕様変更でトークン必須化された場合に備えて設定できるようにしてある。
# INSTAGRAM_OEMBED_TOKEN=your-instagram-oembed-token

# 公開サイトの絶対 URL（OGP 等に使用。任意）。
# NEXT_PUBLIC_SITE_URL=https://your-domain.example.com
